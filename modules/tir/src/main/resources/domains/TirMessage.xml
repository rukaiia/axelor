<?xml version="1.0" encoding="UTF-8"?>
<domain-models
    xmlns="http://axelor.com/xml/ns/domain-models"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://axelor.com/xml/ns/domain-models
        https://axelor.com/xml/ns/domain-models/domain-models_5.4.xsd">

    <module name="tir" package="com.example.tir.db"/>

    <entity name="TirMessage">
        <string name="messageType" title="Тип сообщения" required="true" max="20"/>
        <string name="guaranteeNumber" title="Номер гарантии" max="50"/>
        <string name="iruReference" title="Референс IRU" max="50"/>
        <string name="customsIndex" title="Таможенный индекс" max="50"/>
        <string name="status" title="Статус" required="true" max="20"/>
        <string name="payload" title="XML payload" large="true"/>
        <datetime name="createdAt" title="Дата создания"/>
    </entity>

</domain-models>
