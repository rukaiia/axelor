<?xml version="1.0" encoding="UTF-8"?>
<object-views
        xmlns="http://axelor.com/xml/ns/object-views"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://axelor.com/xml/ns/object-views
        https://axelor.com/xml/ns/object-views/object-views_5.4.xsd">

    <grid name="tir-message-grid"
          title="TIR Сообщения"
          model="com.example.tir.db.TirMessage"
          orderBy="-createdAt"
          editable="false">

        <field name="createdAt" title="Дата" width="160"/>
        <field name="messageType" title="Тип" width="100"/>
        <field name="guaranteeNumber" title="Номер гарантии" width="150"/>
        <field name="iruReference" title="Референс IRU" width="150"/>
        <field name="customsIndex" title="Таможенный индекс" width="150"/>
        <field name="status" title="Статус" width="120"/>
    </grid>

    <form name="tir-message-form"
          title="TIR Сообщение"
          model="com.example.tir.db.TirMessage">

        <panel title="Основные данные">
            <field name="createdAt" title="Дата создания" cols="4"/>
            <field name="messageType" title="Тип сообщения" cols="4"/>
            <field name="status" title="Статус" cols="4"/>
            <field name="guaranteeNumber" title="Номер гарантии" cols="4"/>
            <field name="iruReference" title="Референс IRU" cols="4"/>
            <field name="customsIndex" title="Таможенный индекс" cols="4"/>
        </panel>

        <panel title="XML Payload">
            <field name="payload" title="XML" colSpan="12"/>
        </panel>

        <panel title="XML Response">
            <field name="response" title="Ответ" colSpan="12"/>
        </panel>

    </form>

    <action-view name="action-tir-message-all"
                 title="TIR Сообщения"
                 model="com.example.tir.db.TirMessage">
        <view type="grid" name="tir-message-grid"/>
        <view type="form" name="tir-message-form"/>
    </action-view>

    <menuitem name="menu-tir"
              title="МДП (TIR)"
              icon="fa-exchange"
              order="300"/>

    <menuitem name="menu-tir-messages"
              title="История сообщений"
              parent="menu-tir"
              action="action-tir-message-all"
              order="10"/>

    <form name="tir-exchange-form"
          title="Отправить TIR сообщение"
          model="com.example.tir.db.TirMessage"
          onSave="action-tir-exchange">

        <toolbar>
            <button name="btnExchange"
                    title="Отправить"
                    icon="fa-paper-plane"
                    onClick="action-tir-exchange"/>
        </toolbar>

        <panel title="Запрос">
            <field name="payload" title="XML сообщение" colSpan="12" widget="text"/>
        </panel>

        <panel title="Ответ">
            <field name="response" title="XML ответ" colSpan="12" widget="text" readonly="true"/>
        </panel>

    </form>

    <action-method name="action-tir-exchange">
        <call class="com.example.tir.web.TirExchangeController"
              method="exchangeFromUi"/>
    </action-method>

    <action-view name="action-tir-exchange-form"
                 title="Отправить сообщение"
                 model="com.example.tir.db.TirMessage">
        <view type="form" name="tir-exchange-form"/>
    </action-view>

    <menuitem name="menu-tir-exchange"
              title="Отправить сообщение"
              parent="menu-tir"
              action="action-tir-exchange-form"
              order="5"/>
    <selection name="tir.message.type.select">
        <option value="EPD015">EPD015</option>
        <option value="EPD028">EPD028</option>
        <option value="EPD029">EPD029</option>
        <option value="EPD045">EPD045</option>
        <option value="EPD051">EPD051</option>
    </selection>

    <form name="tir-simple-form"
          title="Быстрая отправка"
          model="com.example.tir.db.TirMessage">

        <toolbar>
            <button name="btnSend"
                    title="Отправить"
                    icon="fa-paper-plane"
                    onClick="action-tir-simple"/>
        </toolbar>

        <panel title="Параметры запроса">
            <field name="messageType" title="Тип сообщения" colSpan="4"
                   selection="tir.message.type.select"/>
            <field name="guaranteeNumber" title="Номер гарантии" colSpan="4"/>
            <field name="iruReference" title="Референс IRU" colSpan="4"/>
            <field name="customsIndex" title="Таможенный индекс" colSpan="4"/>
        </panel>

        <panel title="Ответ">
            <field name="response" title="XML ответ" colSpan="12" widget="text" readonly="true"/>
        </panel>

    </form>

    <action-method name="action-tir-simple">
        <call class="com.example.tir.web.TirExchangeController"
              method="sendSimple"/>
    </action-method>

    <action-view name="action-tir-simple-form"
                 title="Быстрая отправка"
                 model="com.example.tir.db.TirMessage">
        <view type="form" name="tir-simple-form"/>
    </action-view>

    <menuitem name="menu-tir-simple"
              title="Быстрая отправка"
              parent="menu-tir"
              action="action-tir-simple-form"
              order="3"/>

</object-views>


